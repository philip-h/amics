package guest

import (
	"github.com/philip-h/amics/view/model"
	"github.com/philip-h/amics/view/component"
	"github.com/philip-h/amics/view/component/svg"
	"github.com/philip-h/amics/view/layout"
	"strconv"
	"time"
)

templ Home(vm *model.LoginForm) {
	@layout.Base("amics/") {
		@component.Header(
			"/",
			[]component.NavLink{},
			component.NavButton{
				Action: templ.Attributes{
					"href": "/register",
				},
				Text: "Register",
			},
		)
		<section class="border-b border-stone-200 bg-white">
			<div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:px-12 lg:py-18">
				<div>
					<p class="mb-4 font-mono text-xs text-lime-700">$ welcome to amics</p>
					<h1 class="mb-4 text-3xl font-semibold tracking-tight sm:text-4xl">
						Where code gets
						<span class="text-purple-700">written, tested,</span>
						and <span class="text-purple-700">graded</span>.
					</h1>
					<p class="mb-7 max-w-2xl text-sm leading-7 sm:text-base">
						A platform made by <span class="font-semibold text-purple-700">Mr. Habib</span>
						to manage programming assignments with automated pytest grading, unit-based progress tracking, and instant feedback.
					</p>
					<a href="#events" class="inline-flex rounded-md bg-purple-700 px-5 py-2.5 text-sm text-white transition hover:bg-purple-800">
						CS Events @ St Joe's
						@svg.DownArrow()
					</a>
				</div>
				<!-- Login panel -->
				<aside class="rounded-2xl border border-stone-200 bg-stone-100 p-6">
					<h2 class="mb-1 font-semibold">Log in</h2>
					<p class="mb-2 text-xs text-stone-500">Access your assignments and grades.</p>
					@LoginFormErrors(vm)
					if vm.ServerError != "" {
						<div class="text-sm text-red-700 mb-2">
							{ vm.ServerError }
						</div>
					}
					<form
						hx-post="/login"
						hx-push-url="true"
						hx-target="body"
						class="space-y-4"
					>
						<div>
							@component.TextFormControl(templ.Attributes{
								"placeholder":  "e.g. codeking123",
								"value":        vm.Username,
								"autocomplete": "username",
								"autofocus":    vm.Username == "",
								"hx-post":      "/login/validate",
								"hx-trigger":   "change, keyup delay:200ms changed",
							}, "username", "Username", "Username must be at least 4 characters", vm.UsernameProblem())
						</div>
						<div>
							@component.PasswordFormControl(templ.Attributes{
								"value":        vm.Password,
								"autofocus":    vm.Username != "",
								"autocomplete": "current-password",
								"hx-post":      "/login/validate",
								"hx-trigger":   "change, keyup delay:200ms changed",
							})
						</div>
						<button type="submit" class="w-full rounded-md bg-purple-700 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-purple-800 hover:cursor-pointer">Log in</button>
					</form>
					<div class="my-4 flex items-center gap-3">
						<div class="h-px flex-1 bg-stone-200"></div>
						<span class="text-xs text-stone-400">or</span>
						<div class="h-px flex-1 bg-stone-200"></div>
					</div>
					<p class="text-center text-xs text-stone-500">
						Don&apos;t have an account?
						<a href="/register" class="font-medium text-purple-700 hover:underline">Register here</a>
					</p>
				</aside>
			</div>
		</section>
		<section class="grid border-b border-stone-200 bg-white md:grid-cols-3">
			<article class="border-b border-stone-200 p-7 md:border-b-0 md:border-r">
				<div class="mb-4 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-purple-100">
					<img src="/static/icons/clipboard.svg" alt="clipboard icon" class="h-5 w-5"/>
				</div>
				<h3 class="mb-1.5 text-sm font-semibold">Unit-based assignments</h3>
				<p class="text-sm">Assignments are grouped by unit so students always know where they are in the course.</p>
			</article>
			<article class="border-b border-stone-200 p-7 md:border-b-0 md:border-r">
				<div class="mb-4 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-lime-100">
					<img src="/static/icons/test_tube.svg" alt="test tube icon" class="h-5 w-5"/>
				</div>
				<h3 class="mb-1.5 text-sm font-semibold">Automated pytest grading</h3>
				<p class="text-sm">Submit your code and get instant feedback without waiting for your teacher to grade it.</p>
			</article>
			<article class="p-7">
				<div class="mb-4 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100">
					<img src="/static/icons/stat.svg" alt="chart icon" class="h-5 w-5"/>
				</div>
				<h3 class="mb-1.5 text-sm font-semibold">Progress at a glance</h3>
				<p class="text-sm">Students and teachers both see completion rates, grades, and submission status in one place.</p>
			</article>
		</section>
		<section id="events" class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-12">
			<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
				<div>
					<p class="mb-1 font-mono text-xs text-lime-700">$ events --upcoming</p>
					<h2 class="text-xl font-semibold tracking-tight">Upcoming coding events</h2>
				</div>
			</div>
			<div class="grid gap-4 lg:grid-cols-3">
				@event("Nov 9, 2026 - Nov 20, 2026", "Contest", "Beaver Computing Challenge", "https://cemc.uwaterloo.ca/contests/bcc", "The Beaver Computing Challenge (BCC) is an online, multiple-choice contest designed to introduce students to computer science concepts and problem-solving techniques.")
				@event("Dec 7, 2026 - Dec 11, 2026", "AI", "Hour of AI", "https://hourofai.org/", "The Hour of AI is a global initiative by Computer Science Education Week CS Ed Week and the Hour of AI to introduce millions of students to artificial intelligence.")
				@event("Feb 17, 2026", "Contest", "CCC", "https://cemc.uwaterloo.ca/contests/ccc", "Designed to be both accessible to participants with some programming experience and to challenge the keenest programmers at the secondary school level, the CCC helps participants build confidence and grow their ability to understand, design, and implement algorithms.")
			</div>
		</section>
		<footer id="about" class="border-t border-stone-200">
			<div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-7 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-12">
				<a href="/" class="font-mono text-sm font-medium text-purple-700">am<span class="text-lime-700">ics</span></a>
				<p class="font-mono text-xs text-stone-400">{ copyright() }</p>
			</div>
		</footer>
	}
}

templ event(dateAndTime, eventType, title, url, description string) {
	<article class="overflow-hidden rounded-xl border border-stone-200 bg-white">
		<div class="h-1.5 bg-purple-700"></div>
		<div class="p-5">
			<div class="mb-2.5 flex items-center justify-between gap-2">
				<div class="flex items-center">
					<img src="/static/icons/calendar.svg" alt="clipboard icon" class="h-5 w-5"/>
					<p class="font-mono text-[11px] text-stone-500">{ dateAndTime }</p>
				</div>
				<span class="rounded-full bg-indigo-100 px-2.5 py-0.5 font-mono text-[10px] text-indigo-900">{ eventType }</span>
			</div>
			<h3 class="mb-1 text-sm">
				<a href={ url } class="underline">{ title }</a>
			</h3>
			<p class="mb-4 text-sm leading-6 ">{ description }</p>
		</div>
	</article>
}

// Render copyright string for footer
func copyright() string {
	year := time.Now().Year()
	return "© " + strconv.Itoa(year) + "amics"
}

templ LoginFormErrors(vm *model.LoginForm) {
	if vm.Initial {
		{{ return }}
	}
	if vm.Username != "" {
		if len(vm.UsernameProblem()) == 0 {
			@component.ValidationInputConstraint("username", "Username must be at least 4 characters", false)
		} else {
			@component.ValidationInputConstraint("username", vm.UsernameProblem(), true)
		}
	}
	if vm.Password != "" {
		if len(vm.PasswordProblem()) == 0 {
			@component.ValidationInputConstraint("password", "Password must be at least 10 characters", false)
		} else {
			@component.ValidationInputConstraint("password", vm.PasswordProblem(), true)
		}
	}
}
