package teacher

import (
	"github.com/philip-h/amics/view/component"
	"github.com/philip-h/amics/view/layout"
	"github.com/philip-h/amics/view/model"
)

templ ManageCourse(vm *model.CourseForm) {
	@layout.Base("/amics/teacher/course") {
		{{
			navLinks := []component.NavLink{
				component.NavLink{Href: "/teacher", Text: "teacher"},
			}
			if vm.Initial {
				navLinks = append(navLinks, component.NavLink{Href: "", Text: "new course"})
			} else {
				navLinks = append(navLinks, component.NavLink{Href: "", Text: vm.Name})
			}
		}}
		@component.Header(
			"/h",
			navLinks,
			component.NavButton{
				Action: templ.Attributes{
					"hx-post":    "/logout",
					"hx-confirm": "Are you sure you want to logout?",
				},
				Text: "Logout",
			},
		)
		<main class="mx-auto flex flex-col w-full max-w-7xl items-center justify-center px-4 py-14 sm:px-6 lg:px-12">
			<div class="mb-6 w-full max-w-2xl">
				<p class="mb-2 font-mono text-xs text-lime-700">
					if vm.Initial {
						$ course --new
					} else {
						$ course --edit
					}
				</p>
				<h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
					if vm.Initial {
						Create a new course
					} else {
						Edit { vm.Name }
					}
				</h1>
			</div>
			<form
				if vm.Initial {
					hx-post="/teacher/courses"
				} else {
					hx-put={ "/teacher/courses/" + vm.Id }
				}
				hx-push-url="true"
				hx-target="body"
			>
				<section class="grid gap-5 sm:grid-cols-3 w-full max-w-2xl rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
					if vm.ServerError != "" {
						<div class="text-sm text-red-700 mb-2">
							{ vm.ServerError }
						</div>
					}
					<div class="sm:col-span-1">
						@component.TextFormControl(templ.Attributes{
							"value":    vm.Id,
							"readonly": true,
						}, "id", "Id", "Id generated by db.", "")
					</div>
					<div class="sm:col-span-2">
						<div class="flex items-center justify-between">
							<label for="join-code" class="mb-1.5 block text-xs font-medium text-stone-700">Join Code</label>
							<button
								type="button"
								class="text-xs text-purple-700 hover:underline hover:cursor-pointer"
								_="on click 
                                    set chars to 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
                                    set code to ''
                                    repeat 5 times
                                        append (random in chars) to code
                                    end

                                    put code into value of next <input />"
							>
								Generate Join code
							</button>
						</div>
						<input
							id="join-code"
							name="join-code"
							type="text"
							required
							value={ vm.JoinCode }
							aria-describedby="join-code-constraints"
							hx-push-url="false"
							hx-swap="none"
							class="w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none transition placeholder:text-stone-400 focus:border-purple-300 focus:shadow-[0_0_0_3px_rgba(216,180,254,0.35)] aria-[invalid=true]:border-red-700 aria-[invalid=false]:border-lime-700 read-only:bg-stone-100"
						/>
						<small
							id="join-code-constraints"
							class="mt-1.5 block text-xs text-stone-500 aria-[invalid=true]:text-red-700 aria-[invalid=false]:text-lime-700"
						>
							Join code required
						</small>
					</div>
					<div class="sm:col-span-3">
						@component.TextFormControl(templ.Attributes{
							"placeholder": "e.g. Intro to CS",
							"value":       vm.Name,
						}, "name", "Name", "Course name required", vm.NameProblem())
					</div>
					<div class="sm:col-span-2">
						@component.TextFormControl(templ.Attributes{
							"placeholder": "e.g. ICS3U",
							"value":       vm.CourseCode,
						}, "course-code", "Course Code", "Course code required", vm.CourseCodeProblem())
					</div>
					<div class="sm:col-span-1">
						@component.TextFormControl(templ.Attributes{
							"placeholder": "e.g. 1",
							"value":       vm.Section,
							"inputmode":   "numeric",
						}, "section", "Section", "Course section required", vm.SectionProblem())
					</div>
					<div class="sm:col-span-2">
						@component.TextFormControl(templ.Attributes{
							"placeholder": "e.g. 2002",
							"value":       vm.Year,
							"inputmode":   "numeric",
						}, "year", "Year", "Course year required", vm.YearProblem())
					</div>
					<div class="sm:col-span-1">
						@component.TextFormControl(templ.Attributes{
							"placeholder": "1 or 2",
							"value":       vm.Semester,
							"inputmode":   "numeric",
						}, "semester", "Semester", "Course semester required", vm.SemesterProblem())
					</div>
					<div class="sm:col-span-2 flex flex-wrap items-center gap-3 pt-1">
						<button type="submit" class="inline-flex items-center rounded-md bg-purple-700 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-purple-800 hover:cursor-pointer">
							if vm.Initial {
								Create course
							} else {
								Update course
							}
						</button>
					</div>
				</section>
			</form>
		</main>
	}
}

templ CourseFormErrors(vm *model.CourseForm) {
	if vm.Initial {
		{{ return }}
	}
	if vm.JoinCode != "" {
		if len(vm.JoinCodeProblem()) == 0 {
			@component.ValidationInputConstraint("join-code", "Join code is required", false)
		} else {
			@component.ValidationInputConstraint("join-code", vm.JoinCodeProblem(), true)
		}
	}
	if vm.Name != "" {
		if len(vm.NameProblem()) == 0 {
			@component.ValidationInputConstraint("name", "Name is required", false)
		} else {
			@component.ValidationInputConstraint("name", vm.NameProblem(), true)
		}
	}
	if vm.Year != "" {
		if len(vm.YearProblem()) == 0 {
			@component.ValidationInputConstraint("year", "Year is required", false)
		} else {
			@component.ValidationInputConstraint("year", vm.YearProblem(), true)
		}
	}
	if vm.Semester != "" {
		if len(vm.SemesterProblem()) == 0 {
			@component.ValidationInputConstraint("semester", "Semester is required", false)
		} else {
			@component.ValidationInputConstraint("semester", vm.SemesterProblem(), true)
		}
	}
}
