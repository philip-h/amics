package teacher

import (
	"github.com/philip-h/amics/view/component"
	"github.com/philip-h/amics/view/layout"
	"github.com/philip-h/amics/view/model"
)

templ ManageAssignment(vm *model.AssignmentForm, unitNames []string) {
	@layout.Base("/amics/teacher/course") {
		{{
			navLinks := []component.NavLink{
				component.NavLink{Href: "/teacher", Text: "teacher"},
			}
			if vm.Initial {
				navLinks = append(navLinks, component.NavLink{Href: "", Text: "new assignment"})
			} else {
				navLinks = append(navLinks, component.NavLink{Href: "", Text: vm.Name})
			}
		}}
		@component.Header(
			"/h",
			navLinks,
			component.NavButton{
				Action: templ.Attributes{
					"hx-post":    "/logout",
					"hx-confirm": "Are you sure you want to logout?",
				},
				Text: "Logout",
			},
		)
		<main class="mx-auto flex flex-col w-full max-w-7xl items-center justify-center px-4 py-14 sm:px-6 lg:px-12">
			<div class="mb-6 w-full max-w-2xl">
				<p class="mb-2 font-mono text-xs text-lime-700">
					if vm.Initial {
						$ assignment --new
					} else {
						$ assignment --edit
					}
				</p>
				<h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
					if vm.Initial {
						Create a new assignment
					} else {
						Edit { vm.Name }
					}
				</h1>
			</div>
			<form
				if vm.Initial {
					hx-post={ "/teacher/courses/" + vm.CourseId + "/assignments" }
				} else {
					hx-put={ "/teacher/courses/" + vm.CourseId + "/assignments/" + vm.Id }
				}
				hx-target="body"
				class="w-full max-w-2xl"
			>
				<section class="grid gap-5 sm:grid-cols-3 w-full rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8 mb-6">
					<h2 class="text-lg text-stone-400 tracking-tight font-semibold uppercase sm:col-span-3">General</h2>
					if vm.ServerError != "" {
						<div class="text-sm text-red-700 mb-2">
							{ vm.ServerError }
						</div>
					}
					<div class="sm:col-span-1">
						@component.TextFormControl(templ.Attributes{
							"value":    vm.Id,
							"readonly": true,
						}, "id", "Id", "Id generated by db.", "")
					</div>
					<div class="sm:col-span-2">
						@component.TextFormControl(templ.Attributes{
							"value":        vm.UnitName,
							"list":         "unit-name-list",
							"autocomplete": "off",
						}, "unit-name", "Unit Name", "Unit name required", vm.UnitNameProblem())
						<datalist id="unit-name-list">
							if len(unitNames) > 0 {
								for _, unitName := range unitNames {
									<option value={ unitName }></option>
								}
							}
						</datalist>
					</div>
					<div class="sm:col-span-3">
						@component.TextFormControl(templ.Attributes{
							"value": vm.Name,
						}, "name", "Name", "Name required", vm.NameProblem())
					</div>
					<div class="sm:col-span-3">
						<label for="description" class="mb-1.5 block text-xs font-medium text-stone-700">Description</label>
						<textarea
							id="description"
							name="description"
							aria-describedby="description-constraints"
							placeholder="Assignment description"
							rows="10"
							class="w-full field-sizing-content rounded-md border border-stone-300 bg-white px-3 py-2 text-sm outline-none transition placeholder:text-stone-400 focus:border-purple-300 focus:shadow-[0_0_0_3px_rgba(216,180,254,0.35)] aria-[invalid=true]:border-red-700 aria-[invalid=false]:border-lime-700 read-only:bg-stone-100"
						>
							{ vm.Description }
						</textarea>
						<small id="description-constraints" class="mt-1.5 block text-xs text-stone-500">Description required</small>
					</div>
				</section>
				<section class="grid gap-5 sm:grid-cols-3 w-full rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8 mb-6">
					<h2 class="text-lg text-stone-400 tracking-tight font-semibold uppercase sm:col-span-3">Submission Settings</h2>
					<div class="sm:col-span-2">
						@component.TextFormControl(templ.Attributes{
							"placeholder": "e.g. assignment.py",
							"value":       vm.RequiredFilename,
						}, "required-filename", "Required Filename", "Required filename required", vm.RequiredFilenameProblem())
					</div>
					<div class="sm:col-span-1">
						{{
							value := "4"
							if !vm.Initial {
								value = vm.Points
							}
						}}
						@component.TextFormControl(templ.Attributes{
							"inputmode": "numeric",
							"value":     value,
						}, "points", "Points", "Points must be numeric", vm.PointsProblem())
					</div>
					<div class="sm:col-span-3">
						@component.DatetimeFormControl(templ.Attributes{
							"value": vm.DueDate,
						}, "due-date", "Due Date", "Due date required", vm.DueDateProblem())
					</div>
					<div class="sm:col-span-3">
						<label class="inline-flex items-center cursor-pointer w-full">
							<input
								name="visible"
								type="checkbox"
								if vm.Initial {
									checked
								}
								else
								if vm.Visible {
									checked
								}
								class="sr-only peer"
							/>
							<span class="select-none text-sm font-medium">Visible to students</span>
							<div class="relative ms-3 w-9 h-5 bg-stone-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-purple-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-buffer after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-purple-500"></div>
						</label>
					</div>
				</section>
				<section class="flex flex-col gap-3 w-full rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8 mb-6">
					<label for="pytest-code" class="text-lg text-stone-400 tracking-tight font-semibold uppercase">Pytest Code</label>
					<textarea
						id="pytest-code"
						name="pytest-code"
						placeholder="# Pytest code goes here"
						rows="10"
						class="w-full field-sizing-content rounded-md border border-stone-300 bg-white px-3 py-2 text-sm outline-none transition placeholder:text-stone-400 focus:border-purple-300 focus:shadow-[0_0_0_3px_rgba(216,180,254,0.35)] aria-[invalid=true]:border-red-700 aria-[invalid=false]:border-lime-700 read-only:bg-stone-100"
					>
						{ vm.PytestCode }
					</textarea>
				</section>
				<div class="sm:col-span-3 flex flex-wrap items-center gap-3 pt-1">
					<button type="submit" class="inline-flex items-center rounded-md bg-purple-700 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-purple-800 hover:cursor-pointer">
						if vm.Initial {
							Create assignment
						} else {
							Update assignment
						}
					</button>
				</div>
			</form>
		</main>
	}
}
