package student

import (
	"github.com/philip-h/amics/internal/storage"
	"github.com/philip-h/amics/view/component"
	"github.com/philip-h/amics/view/component/svg"
	"github.com/philip-h/amics/view/layout"
	"strconv"
)

templ Assignment(assignment *storage.Assignment, submission *storage.Submission, comments, description, studentId, courseId string) {
	@layout.Base("/amics/0x" + studentId) {
		@component.Header(
			"/h",
			[]component.NavLink{
				component.NavLink{Href: "/c/" + courseId, Text: "0x" + studentId},
				component.NavLink{Href: "", Text: assignment.Name}},
			component.NavButton{
				Action: templ.Attributes{
					"hx-post":    "/logout",
					"hx-confirm": "Are you sure you want to logout?",
				},
				Text: "Logout",
			},
		)
		<div class="min-h-160 max-w-7xl mx-auto">
			<main class="p-4 sm:p-6 lg:p-8">
				<p class="mb-2 font-mono text-xs text-lime-700">$ assignments --view</p>
				if assignment == nil {
					<p class="text-sm text-stone-500">Assignment not found.</p>
					{{ return }}
				}
				<h1 class="text-2xl font-semibold tracking-tight text-zinc-900">{ assignment.Name }</h1>
				<div class="mb-4 text-sm text-stone-500 space-x-4">
					<span>{ assignment.UnitName }</span>
					<span>⋅</span>
					<span>Due { assignment.DueDate.Format("Mon Jan 2, 2006 @ 15:04") }</span>
					<span>⋅</span>
					if submission != nil {
						@component.StatusPill(true, submission.Grade, assignment.Points)
					} else {
						@component.StatusPill(false, 0, assignment.Points)
					}
				</div>
				<div class="mb-6 space-y-4">
					<div class="prose max-w-none prose-code:bg-stone-200 prose-code:rounded-md prose-code:px-2 prose-code:py-1 prose-code:font-normal prose-code:before:content-[''] prose-code:after:content-[''] prose-pre:bg-stone-200  prose-pre:text-stone-700 prose-stone">
						@templ.Raw(description)
					</div>
					<hr class="h-px flex-1 bg-stone-200"/>
					@templ.Fragment("submission-overview") {
						<div hx-target="this" hx-swap="outerHTML">
							if submission != nil {
								if submission.Status == "grading" {
									<div hx-get={ "/c/" + courseId + "/a/" + strconv.Itoa(assignment.Id) + "/poll" } hx-trigger="load delay:1s">
										@Card("Submission", "Just Now") {
											<div class="text-sm text-stone-500 flex items-center">
												<span>Grading assignment</span>
												<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" style="color: rgb(74, 85, 101); opacity: 1; transform: rotate(0deg);" width="64" height="64" viewBox="0 0 24 24"><circle cx="18" cy="12" r="0" fill="currentColor"><animate attributeName="r" begin=".67" calcMode="spline" dur="1.5s" keySplines="0.2 0.2 0.4 0.8;0.2 0.2 0.4 0.8;0.2 0.2 0.4 0.8" repeatCount="indefinite" values="0;2;0;0"></animate></circle><circle cx="12" cy="12" r="0" fill="currentColor"><animate attributeName="r" begin=".33" calcMode="spline" dur="1.5s" keySplines="0.2 0.2 0.4 0.8;0.2 0.2 0.4 0.8;0.2 0.2 0.4 0.8" repeatCount="indefinite" values="0;2;0;0"></animate></circle><circle cx="6" cy="12" r="0" fill="currentColor"><animate attributeName="r" begin="0" calcMode="spline" dur="1.5s" keySplines="0.2 0.2 0.4 0.8;0.2 0.2 0.4 0.8;0.2 0.2 0.4 0.8" repeatCount="indefinite" values="0;2;0;0"></animate></circle></svg>
											</div>
										}
									</div>
								} else {
									@Card("Last Submission Results", submission.SubmittedOn.Format("Mon Jan 2, 2006 @ 15:04")) {
										<div class="grid grid-cols-3 gap-4">
											<div class="flex flex-col justify-center text-xl py-4 px-4 bg-stone-200 rounded-md">
												<span class="text-sm text-stone-500">Score</span>
												<div class="flex gap-2">
													<span class="text-4xl font-semibold text-purple-700">{ submission.Grade }</span>
													<span class="text-sm text-stone-500 self-end">/ { assignment.Points }</span>
												</div>
											</div>
											<div class="flex flex-col justify-center text-xl py-4 px-4 bg-stone-200 rounded-md">
												<span class="text-sm text-stone-500">Graded on</span>
												<span class="text-purple-700">{ submission.GradedOn.Time.Format("Mon Jan 2, 2006 @ 15:04") }</span>
											</div>
											<a
												class="flex flex-col justify-center text-xl py-4 px-4 bg-stone-200 rounded-md hover:bg-stone-300 transition hover:cursor-pointer"
												href={ "/c/" + courseId + "/a/" + strconv.Itoa(assignment.Id) + "/code" }
												hx-boost="false"
											>
												<span class="text-sm text-stone-500">File Submitted</span>
												<span class="text-purple-700">{ assignment.RequiredFilename }</span>
											</a>
										</div>
										<pre class="text-stone-400">
											@templ.Raw(comments)
										</pre>
									}
								}
							} else {
								@Card("Submission", "Just Now") {
									<p class="text-sm text-stone-500">You have not submitted this assignment yet.</p>
								}
							}
						</div>
					}
					{{ buttonText := "Submit" }}
					if submission != nil {
						{{ buttonText = "Re-Submit" }}
					}
					@Card(buttonText, assignment.RequiredFilename) {
						<form class="space-y-2" hx-post={ "/c/" + courseId + "/a/" + strconv.Itoa(assignment.Id) } hx-encoding="multipart/form-data" hx-target="body" hx-push-url="true">
							<!-- <label for="file" class="text-slate-900 text-sm font-medium mb-2 block">
								Upload file
							</label>
							<input
								type="file"
								name="file"
								id="file"
								accept=".py"
								aria-describedby="file-constraints"
								class="w-full text-slate-600 font-medium text-sm border border-slate-200 rounded-md cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 file:cursor-pointer file:border-0 file:py-2 file:px-3 file:mr-4 file:bg-gray-100 hover:file:bg-gray-200 file:text-slate-500 aria-[invalid=true]:border-red-700 aria-[invalid=false]:border-lime-700"
								required
								_={ fmt.Sprintf(`init set my value to '' then get next <button/> then add @disabled to it
									on change
										set rfn to '%s'
										if my.files[0] is null
										get next <button/> then add @disabled to it
										exit
									end
									if my.files[0].name is not rfn
										set my @aria-invalid to 'true'
										get #file-constraints then set it's @aria-invalid to 'true'
										set my value to ''
										get next <button/> then add @disabled to it
									else
										set my @aria-invalid to 'false'
										get #file-constraints then set it's @aria-invalid to 'false'
										get next <button/> then remove @disabled from it
									end`, assignment.RequiredFilename) }
							/>
							<small id="file-constraints" class="block text-xs aria-[invalid=true]:text-red-700 aria-[invalid=false]:text-lime-700">Please upload { assignment.RequiredFilename }</small>
							-->
							@component.FileDropzoneFormControl(templ.Attributes{
								"accept":                 ".py",
								"data-required-filename": assignment.RequiredFilename,
								"_": `
								def validFile(constraint, hint)
									set my @aria-invalid to 'false'
									get #file-dropzone then remove @aria-error from it then add @aria-has-file to it
									get <p[data-file-constraint]/> then set it's innerText to constraint 
									get <p[data-file-hint]/> then set it's innerText to hint
									get next <button/> then remove @disabled from it
								end

								def invalidFile(constraint, hint)
									set my @aria-invalid to 'true'
									get #file-dropzone then remove @aria-has-file from it then add @aria-error to it
									get <p[data-file-constraint]/> then set it's innerText to constraint 
									get <p[data-file-hint]/> then set it's innerText to hint
									get next <button/> then add @disabled to it
								end

								def validate(file)
									set rfn to my @data-required-filename
									if file is null
										exit
									end

									get <p[data-file-name/>
									remove .invisible from it
									set its innerText to file's name
									if file's name is not rfn
										invalidFile('Please upload ' + rfn, 'File name does not match expected filename')
									else
										-- ensure file is not blank (happens if students forget to save)
										make a FileReader called reader
										call reader.readAsText(file)
										wait for a load from reader
										if reader.result.trim() is ''
											invalidFile(rfn + ' is empty', 'Please ensure you have saved your code before submitting')
										else
											validFile(rfn + 'sucessfully loaded', 'Go ahead and Grade assignment')
										end
									end
								end
								init set my value to '' then get next <button/> then add @disabled to it
								on gotfiles call validate(first of my files)
								on change call validate(first of my files)`,
							},
								svg.PythonSVG(),
								"file",
								"Submit code",
								"Please upload "+assignment.RequiredFilename,
								"",
							)
							<button type="submit" class="block rounded-md bg-purple-700 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-purple-800 hover:cursor-pointer disabled:opacity-50 disabled:hover:bg-purple-700 disabled:hover:cursor-not-allowed">
								if submission == nil {
									Grade Assignment
								} else {
									Re-Grade Assignment
								}
							</button>
						</form>
					}
				</div>
			</main>
		</div>
	}
}

templ Card(heading, subheading string) {
	<div class="overflow-hidden rounded-xl border border-stone-200 bg-white">
		<div class="flex items-center gap-3 border-b border-stone-200 p-4">
			<p class="flex-1 text-xs text-stone-700 uppercase">{ heading }</p>
			if subheading != "" {
				<p class="text-xs text-stone-500">{ subheading }</p>
			}
		</div>
		<div class="border-b border-stone-100 p-4 overflow-x-scroll">
			{ children... }
		</div>
	</div>
}
